# Example Configuration for Ironclad-DB

## Azure Storage Configuration
# Your Azure Storage account URL (Premium ZRS recommended for production)
STORAGE_ACCOUNT_URL=https://your-account.blob.core.windows.net

# Container name for storing blobs
CONTAINER_NAME=ironclad-db

# Page blob name for data storage (will store key-value pairs)
PAGE_BLOB_NAME=shard-0.blob

# WAL blob name for write-ahead log
WAL_BLOB_NAME=shard-0.wal

# Initialization mode
# Set to "true" for first-time setup to create new blobs
# Set to "false" for normal operation (recovery mode)
INIT_MODE=false

## Server Configuration
# gRPC service port
GRPC_PORT=9090

# HTTP health check port
HTTP_PORT=8080

## Azure Authentication
# Option 1: Azure CLI (for local development)
#   Run: az login

# Option 2: Managed Identity (for AKS deployment)
#   Configure workload identity in Kubernetes

# Option 3: Service Principal
#   Set these environment variables:
# AZURE_TENANT_ID=your-tenant-id
# AZURE_CLIENT_ID=your-client-id
# AZURE_CLIENT_SECRET=your-client-secret

## Performance Tuning (Future)
# WAL_BATCH_SIZE=16384  # Batch size for WAL writes (bytes)
# CHECKPOINT_INTERVAL=3600  # Checkpoint interval (seconds)
# MAX_SLOTS=100000  # Maximum number of slots per shard
